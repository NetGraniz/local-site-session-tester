{
  "name": "local-site-visitor",
  "version": "1.3.0",
  "description": "Локальное Windows-приложение для контролируемого тестирования сайта в изолированных браузерных сессиях",
  "main": "main.js",
  "author": "Local Site Visitor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install-browser": "set PLAYWRIGHT_BROWSERS_PATH=0&& playwright install chromium",
    "postinstall": "set PLAYWRIGHT_BROWSERS_PATH=0&& playwright install chromium",
    "check": "node --check main.js && node --check preload.js && node --check lib/scheduler.js && node --check lib/runtime-utils.js && node --check lib/random-actions.js && node --check src/renderer.js && node --check scripts/self-test.js && node --check scripts/scheduler-self-test.js && node --check scripts/repeat-browser-self-test.js && node --check scripts/runtime-utils-self-test.js && node --check scripts/random-actions-self-test.js && node --check scripts/ui-contract-self-test.js",
    "test:browser": "node scripts/self-test.js",
    "test:scheduler": "node scripts/scheduler-self-test.js",
    "test:repeat-browser": "node scripts/repeat-browser-self-test.js",
    "test:runtime": "node scripts/runtime-utils-self-test.js",
    "test:actions": "node scripts/random-actions-self-test.js",
    "test:ui": "node scripts/ui-contract-self-test.js",
    "smoke": "electron . --smoke-test",
    "smoke:cycles": "electron . --cycle-smoke-test",
    "smoke:stop": "electron . --stop-smoke-test",
    "smoke:actions": "electron . --actions-smoke-test",
    "dist:win": "electron-builder --win nsis --x64",
    "pack:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "playwright": "1.62.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.localsitevisitor.app",
    "productName": "Local Site Visitor",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright-core/.local-browsers/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/icon.ico",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local Site Visitor",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
